# Optional. Copy to .env to override the defaults; the server reads it at startup.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/inspections.sqlite

# Shared sign-in password for the app. Defaults to "supervisor" with a warning.
APP_PASSWORD=supervisor

# Bearer token the mock SAP webhook expects. Defaults to "sap-dev-secret".
SAP_WEBHOOK_SECRET=sap-dev-secret

# Signs the session cookie. Leave blank and one is generated on first start and
# kept in data/session-secret.
AUTH_SECRET=
